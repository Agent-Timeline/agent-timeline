{
  "version": 1,
  "name": "Chat Completions cancellation",
  "appUrl": "http://127.0.0.1:4469/sse.html",
  "proxy": {
    "port": 4468,
    "path": "/v1/chat/completions",
    "scenario": {
      "version": 1,
      "id": "cancel-late-result",
      "prompt": "Suggest a title for my weekend project",
      "cancelAtMs": 700,
      "observeUntilMs": 1800,
      "events": [
        {
          "atMs": 100,
          "type": "text",
          "text": "A possible title is "
        },
        {
          "atMs": 1100,
          "type": "text",
          "text": "Weekend Atlas"
        },
        {
          "atMs": 1300,
          "type": "complete"
        }
      ],
      "assertion": {
        "type": "textAbsentAfterCancel",
        "text": "Weekend Atlas"
      }
    },
    "protocol": "chat-completions"
  },
  "setup": [
    {
      "atMs": 0,
      "type": "select",
      "selector": "#mode",
      "value": "fixed"
    }
  ],
  "actions": [
    {
      "atMs": 0,
      "type": "click",
      "selector": "#send"
    },
    {
      "atMs": 700,
      "type": "click",
      "selector": "#cancel"
    }
  ],
  "observeUntilMs": 2200,
  "assertions": [
    {
      "type": "textAbsent",
      "selector": "#response",
      "text": "Weekend Atlas",
      "fromMs": 700
    }
  ],
  "evidence": [
    {
      "selector": "#events",
      "text": "Text received: Weekend Atlas"
    },
    {
      "selector": "#events",
      "text": "Stream ended"
    }
  ]
}
